<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Mic for the wake-word engine -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Foreground service plumbing (microphone type = always-on listening) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Persistent "listening" notification + the high-priority wake notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the wake notification pop Muse open even from the lock screen.
         Works with just the manifest entry because we target API 33
         (Android 14+ gates this behind a Settings toggle for targetSdk 34+). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Pause listening during phone calls so we never glitch call audio -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Restart listening after a reboot if it was enabled -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".WakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
